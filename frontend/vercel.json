{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://dark-synapses-api.onrender.com/api/:path*"
    },
    {
      "source": "/",
      "destination": "/index.html"
    },
    {
      "source": "/about",
      "destination": "/about/index.html"
    },
    {
      "source": "/services",
      "destination": "/services/index.html"
    },
    {
      "source": "/services/ai",
      "destination": "/services/ai/index.html"
    },
    {
      "source": "/services/cybersecurity",
      "destination": "/services/cybersecurity/index.html"
    },
    {
      "source": "/services/ai-security",
      "destination": "/services/ai-security/index.html"
    },
    {
      "source": "/services/ai-powered-security",
      "destination": "/services/ai-powered-security/index.html"
    },
    {
      "source": "/services/content-authenticity-digital-forensics",
      "destination": "/services/content-authenticity-digital-forensics/index.html"
    },
    {
      "source": "/projects",
      "destination": "/projects/index.html"
    },
    {
      "source": "/contact",
      "destination": "/contact/index.html"
    },
    {
      "source": "/security-researcher",
      "destination": "/security-researcher/index.html"
    },
    {
      "source": "/login",
      "destination": "/login/index.html"
    },
    {
      "source": "/register",
      "destination": "/register/index.html"
    },
    {
      "source": "/dashboard",
      "destination": "/dashboard/index.html"
    },
    {
      "source": "/admin",
      "destination": "/admin/index.html"
    },
    {
      "source": "/service-requests",
      "destination": "/service-requests/index.html"
    },
    {
      "source": "/system",
      "destination": "/system/index.html"
    },
    {
      "source": "/admin/requests/:requestId",
      "destination": "/admin/index.html"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/fallback.html"
    }
  ],
  "headers": [
    {
      "source": "/login",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/register",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/dashboard",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/admin",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/admin/requests/:requestId",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/service-requests",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/system",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ]
}